PORT=3001

# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/ong_estoque

# Deixe "false" no banco local. Em hospedagem na nuvem (Neon, Render...), use "true".
DB_SSL=false

JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

JWT_EXPIRA=8h