# Copie este arquivo para ".env" e preencha com os dados do SEU banco local.
# O arquivo ".env" NÃO vai pro GitHub (está no .gitignore).

PORT=3001

# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/ong_estoque

# Deixe "false" no banco local. Em hospedagem na nuvem (Neon, Render...), use "true".
DB_SSL=false

# Chave secreta que assina os tokens de login. Cada pessoa gera a sua.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
# Tempo de validade do login (ex.: 8h, 1d)
JWT_EXPIRA=8h

# --- Só para PRODUÇÃO (no servidor de hospedagem; no seu computador pode ficar de fora) ---

# Em produção, use "production". Isso também faz o servidor recusar uma JWT_SECRET fraca.
# NODE_ENV=production

# Endereço do site (frontend) que pode chamar a API. Vários? Separe por vírgula.
# Exemplo: CORS_ORIGIN=https://estoque.suaong.org.br
# Se o site e a API ficarem no MESMO endereço (o servidor do site repassa /api para a API),
# não precisa definir.
# CORS_ORIGIN=